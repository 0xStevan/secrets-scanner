# Python virtual environment — machine-specific, huge, never commit
venv/

# Compiled Python files — auto-generated, never commit
__pycache__/
*.pyc

# Environment files — may contain real secrets, NEVER commit
.env
.env.local

# Pokemon monitor live config — holds API keys / SMTP passwords / webhook URLs
pokemon-monitor/config.json
# Pokemon monitor runtime state (stock memory) — machine-local, not source
pokemon-monitor/*.json.tmp
pokemon-monitor/monitor-state.json

# OS-generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
